{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  // Evita que Tab saque el foco del editor (suele parecer que "no indenta")
  "editor.tabMovesFocus": false,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  // Atajos estándar para indentar bloques (por si hubo conflictos de extensión)
  "editor.autoIndent": "full"
}
