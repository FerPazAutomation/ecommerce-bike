DATABASE_URL=postgresql://ebike:ebike_dev@localhost:5433/ebike_tucson
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173

# Stripe (modo prueba): Developers → API keys → Secret key (empieza por sk_test_).
# Sin esto, POST /orders/checkout responde 503.
STRIPE_SECRET_KEY=

# Opcional en local: para que el pedido pase a "pagado" tras el pago, Stripe debe
# poder llamar al webhook. Instala Stripe CLI y ejecuta:
#   stripe listen --forward-to http://127.0.0.1:8000/webhooks/stripe
# Copia el "whsec_..." que muestra la CLI y pégalo aquí; reinicia uvicorn.
STRIPE_WEBHOOK_SECRET=
